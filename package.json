{
  "name": "system-design-25-realtime-leaderboard",
  "version": "0.1.0",
  "description": "Authoritative score events with immutable verified Redis ranking publications",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/main.js serve",
    "lint": "node scripts/repo-check.mjs",
    "test": "node --test --test-reporter=spec test/unit/*.test.js",
    "test:infra": "node --test --test-reporter=spec test/integration/postgresql-redis.test.js",
    "test:crash": "node --test --test-reporter=spec test/integration/crash.test.js",
    "smoke:infra": "node scripts/infra-smoke.mjs",
    "benchmark:infra": "node scripts/infra-benchmark.mjs",
    "audit": "npm audit --audit-level=high",
    "check": "npm run lint && npm test && npm run audit",
    "check:ci": "npm run check && npm run test:infra && npm run test:crash && npm run smoke:infra && npm run benchmark:infra"
  },
  "dependencies": {
    "pg": "8.23.1",
    "redis": "6.2.1"
  },
  "keywords": [
    "system-design",
    "leaderboard",
    "postgresql",
    "redis",
    "data-integrity"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/estelledc/system-design-25-realtime-leaderboard.git"
  },
  "bugs": {
    "url": "https://github.com/estelledc/system-design-25-realtime-leaderboard/issues"
  },
  "homepage": "https://github.com/estelledc/system-design-25-realtime-leaderboard#readme",
  "license": "MIT"
}
